@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStore Auth
@inject NavigationManager Navigation
@inject PwaUpdateService Pwa
@inject InstallPrompt Install

<div class="app-shell">
    <header class="band">
        <a class="band__title" href="">Messblatt</a>
        <span class="band__chip">KW @Format.WeekOfYear(DateOnly.FromDateTime(DateTime.Now))</span>
    </header>

    @if (Install.Visible)
    {
        <div class="install">
            <div class="install__text">
                <span class="eyebrow">Auf den Startbildschirm</span>
                <p class="prose">
                    @(Install.CanPrompt
                        ? "Messblatt als App installieren? Danach startet die Karte ohne Browserleiste."
                        : "Im Teilen-Menü \"Zum Home-Bildschirm\" wählen, dann startet die Karte wie eine App.")
                </p>
            </div>
            <div class="install__actions">
                @if (Install.CanPrompt)
                {
                    <button type="button" class="btn btn--quiet" @onclick="InstallApp">Installieren</button>
                }
                <button type="button" class="btn btn--quiet" @onclick="DismissInstall">Nein danke</button>
            </div>
        </div>
    }

    @if (Pwa.UpdateAvailable)
    {
        <div class="banner">
            <span>Eine neue Version liegt bereit.</span>
            <button type="button" class="btn btn--quiet" style="width: auto" @onclick="ApplyUpdate">Jetzt laden</button>
        </div>
    }

    <main class="page">
        @Body
    </main>

    <nav class="tabbar">
        <NavLink class="tab" href="" Match="NavLinkMatch.All">
            <span class="tab__mark"></span>
            Heute
        </NavLink>
        <NavLink class="tab" href="verlauf">
            <span class="tab__mark"></span>
            Verlauf
        </NavLink>
        <NavLink class="tab" href="profil">
            <span class="tab__mark"></span>
            Profil
        </NavLink>
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var token = await Auth.GetTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("anmelden", replace: true);
            return;
        }

        Pwa.Changed += OnUpdateAnnounced;
        Install.Changed += OnUpdateAnnounced;
        await Pwa.InitializeAsync();
        await Install.InitializeAsync();
    }

    private void OnUpdateAnnounced() => InvokeAsync(StateHasChanged);

    private Task ApplyUpdate() => Pwa.ApplyUpdateAsync();

    private Task InstallApp() => Install.InstallAsync();

    private Task DismissInstall() => Install.DismissAsync();

    public void Dispose()
    {
        Pwa.Changed -= OnUpdateAnnounced;
        Install.Changed -= OnUpdateAnnounced;
    }
}
